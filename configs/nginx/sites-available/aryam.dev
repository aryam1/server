server {
    server_name aryam.dev www.aryam.dev;

    root /var/www/aryam.dev;
    index index.html;

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/aryam.dev/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/aryam.dev/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot


}
server {
    if ($host = www.aryam.dev) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    if ($host = aryam.dev) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    server_name aryam.dev www.aryam.dev;
    return 404; # managed by Certbot




}