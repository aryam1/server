server {
    server_name qb.aryam.dev;
    access_log /var/log/nginx/qb.aryam.dev.access.log;
    
    location / {
        proxy_pass http://localhost:4201;
        proxy_http_version 1.1;

        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host   $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;	
    }


    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/qb.aryam.dev/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/qb.aryam.dev/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}
server {
    if ($host = qb.aryam.dev) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    server_name qb.aryam.dev;
    listen 80;
    return 404; # managed by Certbot


}
